# --- Databricks (OAuth M2M service principal) ---
# Workspace URL, e.g. https://<workspace-id>.cloud.databricks.com
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_CATALOG=bemol_prod
DATABRICKS_SCHEMA=observability

# --- PageSpeed Insights ---
PSI_API_KEY=

# --- Google Search Console (service account) ---
# Path to the service account JSON key file, or the JSON contents base64-encoded
GSC_SERVICE_ACCOUNT_KEY=
GSC_SITE_URL=https://www.bemol.com.br/

# --- Alerting ---
SLACK_WEBHOOK_URL=
